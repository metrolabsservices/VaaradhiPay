        color: #666;
        font-size: 0.9rem;
        cursor: pointer;
        padding: 7px 12px;
    }

    .user-profile-bankaccount-custom-file-input {
        position: absolute;
        top: 0;
        left: 0;
        width: 36px;
        height: 50px;
        opacity: 0;
