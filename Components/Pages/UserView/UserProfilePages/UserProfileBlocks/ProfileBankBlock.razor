            font-size: 12px;
            display: block;
            margin-bottom: 5px;
            text-align: left;
            color: #666;
        }


    .user-profile-bankaccount-bank-account-input {
        width: 356px;
        height: 50px;
        border: 1px solid #ccc;
        border-radius: 4px;
        padding: 0 10px;
        font-size: 14px;
    }


    .user-profile-bankaccount-bank-account-save-btn {
        margin-top: 30px;
        width: 180px;
        height: 40px;
        background-color: #DF0A0A;
        border: none;
        border-radius: 20px;
        color: #fff;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        transition: background-color 0.3s ease;
    }

        .user-profile-bankaccount-bank-account-save-btn:hover {
            background-color: #cc001f;
        }

    .user-profile-bankaccount-open-modal-btn {
        background-color: #e60023;
        border: none;
        border-radius: 20px;
        color: #fff;
        padding: 10px 20px;
        font-size: 14px;
        font-weight: bold;
        cursor: pointer;
        margin: 20px;
        transition: background-color 0.3s ease;
    }

        .user-profile-bankaccount-open-modal-btn:hover {
            background-color: #cc001f;
        }


    .user-profile-bankaccount-closemodel {
        color: black;
        font-size: 20px;
        font-weight: 30px;
    }


    .user-profile-bankaccount-modal-content {
        border-radius: 8px;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    .user-profile-bankaccount-modal-header {
        border-bottom: 1px solid #ddd;
    }

    .user-profile-bankaccount-modal-title {
