        background-color: #cc001f;
    }

    .user-profile-bankaccount-input-fields-div {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

        .user-profile-bankaccount-input-fields-div label {
            align-items: start !important;
            text-align-last;
        }


    .user-profile-bankaccount-bank-account-body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .user-profile-bankaccount-bank-account-modal {
