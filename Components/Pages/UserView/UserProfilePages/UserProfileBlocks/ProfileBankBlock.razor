        top: 32px;
        left: 23px;
        gap: 0px;
        opacity: 0px;
        font-size: 18px;
        font-weight: 650;
        line-height: 55px;
    }

    .user-profile-bankaccount-modal-body {
        padding: 20px;
    }

    /* Form Styling */
    .user-profile-bankaccount-form-group {
        margin-bottom: 15px;
    }

