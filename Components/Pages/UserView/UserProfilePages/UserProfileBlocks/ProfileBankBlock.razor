<div>

    <EditForm Model="BankAccountModel" OnValidSubmit="SaveBankAccount" class="form">
        <div class="user-profile-bankaccount-input-fields-div">
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="BankName"> Bank Name</label>
                <InputText id="BankName" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.BankName" placeholder="" />
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="AccountName">Bank Account Name</label>
                <InputText id="AccountName" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.AccountHolderName" placeholder="" />
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="AccountNumber">Bank Account Number</label>
                <InputText id="AccountNumber" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.AccountNumber" placeholder="" />
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="branchcode">Branch Code</label>
                <InputText id="branchcode" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.BranchCode" placeholder="" />
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="IFSCCode">IFSC Code</label>
                <InputText id="IFSCCode" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.IFSCCode" placeholder="" />
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="CurrencyType">Currency Type</label>
                <InputSelect id="CurrencyType" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.CurrencyType">
                    <option value="" disabled selected>Select Currency</option>
                    <option value="USD">USD</option>
                    <option value="INR">INR</option>
                    <option value="AED">AED</option>
                </InputSelect>
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group">
                <label for="accountType">Account Type</label>
                <InputSelect id="accountType" class="user-profile-bankaccount-bank-account-input" @bind-Value="BankAccountModel.AccountType">
                    <option value="" disabled selected>Select AccountType</option>

                    <option value="Saving">Saving</option>
                    <option value="Business">Business</option>
                    <option value="Checking">Checking</option>
                </InputSelect>
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group  user-profile-bankaccount-customfileinput">
                <label for="FileUpload">Bank Account Proof (Upload statement or cheque)</label>
                <p class="user-profile-bankaccount-note">NOTE: Only (JPEG/PNG/PDF) file types are allowed and MAX size: 10mb</p>
                <div class="user-profile-bankaccount-custom-file-container">
                    <label for="FileUpload" class="user-profile-bankaccount-custom-file-label">
                        <span>@(SelectedFileName ?? "Browse file")</span>
                        <InputFile id="FileUpload" class="user-profile-bankaccount-custom-file-input" OnChange="OnFileSelected" />
                    </label>
                </div>
            </div>
            <div class="user-profile-bankaccount-bank-account-form-group text-center">
                <button type="submit" class="user-profile-bankaccount-bank-account-save-btn">Save</button>
            </div>
        </div>
    </EditForm>

</div>


@code {

    private BankAccount BankAccountModel = new();
    private string SelectedFileName { get; set; }

    [Parameter] public EventCallback OnFormSubmit { get; set; }
    private IBrowserFile selectedFile;
    private async Task SaveBankAccount()
    {
        BankAccountModel.UserId = LocalStorage.LoggedInInfo.Id;

        if (selectedFile != null)
        {
            try
            {
                // After uploading, update the proof file path
                BankAccountModel.ProofFilePath = await fileStorageService.UploadingFiles(selectedFile, "BankAccount");
                Console.WriteLine($"File '{SelectedFileName}' uploaded successfully.");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error uploading file: {ex.Message}");
                // Handle error appropriately, e.g., show an error message
            }
        }

        // Handle saving logic here
        await bankAccountService.AddBankAccountAsync(BankAccountModel);

        await OnFormSubmit.InvokeAsync();

        Console.WriteLine($"Bank Account Saved: {BankAccountModel.BankName}");
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        SelectedFileName = selectedFile.Name;
        BankAccountModel.ProofFilePath = SelectedFileName;
        Console.WriteLine($"File Selected: {SelectedFileName}");
    }
}