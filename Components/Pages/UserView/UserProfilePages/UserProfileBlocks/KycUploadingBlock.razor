@using VaaradhiPay.DTOs
@using VaaradhiPay.Data
@using VaaradhiPay.Services.Interfaces
@inject IJSRuntime JSRuntime
@inject IBucketManager MinioService
@inject IFileStorageService fileStorageService

<div class="row mb-4 kyc-upload-main-container">
    @if (isFrontUploaded)
    {
        <div class="col-12 col-md-6 kyc-upload-container">
            <p class="kycuploadingblock-upload-text-primary">Uploaded @KycType front</p>
            <div class="uploaded-file ms-1">
                <img src="@FrontUrl"  width="180" height="130" />
            </div>
        </div>
    }
    else
    {
        <div class="col-12 col-md-6 kyc-upload-container">
            @if (filePreviews.ContainsKey(KycType) && filePreviews[KycType].ContainsKey(UploadDirectionFront))
            {
                <p class="kycuploadingblock-upload-text-primary">Uploaded @KycType front</p>

                var file = filePreviews[KycType][UploadDirectionFront];
                <div class="uploaded-file ms-1">
                    <img src="@file.PreviewUrl" alt="@file.FileName" width="180" height="130" />
                    <button class="btn btn-danger btn-sm mt-2" @onclick="() => RemoveFile(KycType, UploadDirectionFront)">
                        Remove
                    </button>
                </div>
            }
            else
            {
                <p class="kycuploadingblock-upload-text-primary">Upload @KycType front</p>
                <div class="w-75 kycuploadingblock-uplodcontainer" @onclick="() => UploadonClick(UploadDirectionFront)">
                    <i class="bi bi-camera-fill me-3" />
                    <p class="m-0 px-4 py-3 kycuploadingblock-upload-text"> <span class="text-danger">Browse</span> to Upload</p>
                </div>
            }
        </div>
    }

    @if (isBackUploaded)
    {
        <div class="col-12 col-md-6 kyc-upload-container">
            <p class="kycuploadingblock-upload-text-primary">Uploaded @KycType back</p>
            <div class="uploaded-file ms-1">
                <img src="@BackUrl" width="180" height="130" />
            </div>
        </div>
    }
    else
    {
        <div class="col-12 col-md-6 kyc-upload-container">
            @if (filePreviews.ContainsKey(KycType) && filePreviews[KycType].ContainsKey(UploadDirectionBack))
            {
                <p class="kycuploadingblock-upload-text-primary">Uploaded @KycType front</p>
                var file = filePreviews[KycType][UploadDirectionBack];
                <div class="uploaded-file ms-1">
                    <img src="@file.PreviewUrl" alt="@file.FileName" width="180" height="130" />
                    <button class="btn btn-danger btn-sm mt-2" @onclick="() => RemoveFile(KycType, UploadDirectionBack)">
                        Remove
                    </button>
                </div>
            }
            else
            {
                <p class="kycuploadingblock-upload-text-primary">Upload @KycType back</p>
                <div class="w-75 kycuploadingblock-uplodcontainer" @onclick="() => UploadonClick(UploadDirectionBack)">
                    <i class="bi bi-camera-fill me-3" />
                    <p class="m-0 px-4 py-3 kycuploadingblock-upload-text"> <span class="text-danger">Browse</span> to Upload</p>
                </div>
            }
        </div>
    }

    @if (isError)
    {
        <p class="text-danger">NOTE : Only (JPEG/PNG/PDF) file types are allowed and MAX size : 10mb</p>
    }
</div>

<!-- Hidden InputFile -->
<InputFile @ref="fileInputElementKYC" style="display: none;" OnChange="@(e => HandleFileSelected(e, KycType))" />

@code {
    [Parameter]
    public string KycType { get; set; }
    [Parameter]
    public EventCallback<Dictionary<string, Dictionary<string, FilePreviewDTO>>> onUploadCheck { get; set; }
    [Parameter]
    public List<KYCDetails> kYCDetails { get; set; }

    private Dictionary<string, Dictionary<string, FilePreviewDTO>> filePreviews = new();

    public string UploadDirection { get; set; }

    private ErrorHandleDTO ErrorDetails = new();
    private InputFile fileInputElementKYC;
    private bool isError = false;
    private string UploadDirectionFront = "FRONT";
    private string UploadDirectionBack = "BACK";
    private bool isFrontUploaded = false;
    private bool isBackUploaded = false;
    private string FrontUrl;
    private string BackUrl;

    protected override async Task OnParametersSetAsync()
    {
        if (kYCDetails != null && kYCDetails.Any())
        {
            foreach (var detail in kYCDetails)
            {
                try
                {
                    if (detail.DocumentNumber == UploadDirectionFront)
                    {
                        isFrontUploaded = true;
                        FrontUrl = await fileStorageService.GeneratePresignedUrlAsync(null,detail.DocumentFilePath);
                    }
                    if (detail.DocumentNumber == UploadDirectionBack)
                    {
                        isBackUploaded = true;
                        BackUrl = await fileStorageService.GeneratePresignedUrlAsync(null,detail.DocumentFilePath);
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine(ex.Message);
                }
            }
        }
    }

    private async Task UploadonClick(string UploadDirect)
    {
        UploadDirection = UploadDirect;
        await JSRuntime.InvokeVoidAsync("triggerClick", fileInputElementKYC.Element);
    }

    private async Task HandleFileSelected(InputFileChangeEventArgs e, string documentType)
    {
        var file = e.File;

        var allowedExtensions = new HashSet<string>(StringComparer.OrdinalIgnoreCase)
        {
            ".jpg", ".jpeg", ".png", ".gif", ".bmp", ".tiff", ".webp", ".heif", ".heic"
        };

        try
        {
            if (file == null)
            {
                await JSRuntime.InvokeVoidAsync("showAlert", "No file selected!");
                ErrorDetails = new ErrorHandleDTO
                    {
                        IsError = true,
                        Message = "No file selected!",
                    };
                return;
            }

            var fileExtension = Path.GetExtension(file.Name).ToLowerInvariant();
            if (!allowedExtensions.Contains(fileExtension))
            {
                await JSRuntime.InvokeVoidAsync("showAlert", $"File {file.Name} must be one of the following formats: jpg, jpeg, png, gif, bmp, tiff, webp, heif, heic.");
                return;
            }

            var filePreview = new FilePreviewDTO
                {
                    FileName = file.Name,
                    PreviewUrl = await GetFilePreviewUrl(file),
                    ContentType = file.ContentType
                };

            // Ensure the documentType is initialized in the dictionary
            if (!filePreviews.ContainsKey(documentType))
            {
                filePreviews[documentType] = new Dictionary<string, FilePreviewDTO>();
            }

            // Set the file preview for the appropriate side (front/back)
            filePreviews[documentType][UploadDirection] = filePreview;

            bool isUploaded = filePreviews[documentType].ContainsKey(UploadDirectionFront) && filePreviews[documentType].ContainsKey(UploadDirectionBack);
            if (isUploaded)
            {
                // Call UploadCheck if both sides are uploaded
                await UploadCheck(filePreviews);
            }
        }
        catch (Exception ex)
        {

        }
    }

    // Generate a preview URL from the uploaded file
    private async Task<string> GetFilePreviewUrl(IBrowserFile file)
    {
        try
        {
            using var stream = new MemoryStream();
            await file.OpenReadStream().CopyToAsync(stream);
            var buffer = stream.ToArray();
            var base64String = Convert.ToBase64String(buffer);
            return $"data:{file.ContentType};base64,{base64String}";
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
            throw;
        }
    }

    private async Task UploadCheck(Dictionary<string, Dictionary<string, FilePreviewDTO>> filePreviews)
    {
        await onUploadCheck.InvokeAsync(filePreviews);
        StateHasChanged();
    }

    private void RemoveFile(string documentType, string uploadDirection)
    {
        // Remove the file from the filePreviews dictionary
        if (filePreviews.ContainsKey(documentType) && filePreviews[documentType].ContainsKey(uploadDirection))
        {
            filePreviews[documentType].Remove(uploadDirection);

            // If the dictionary for the document type is empty, remove it
            if (!filePreviews[documentType].Any())
            {
                filePreviews.Remove(documentType);
            }

        }

        StateHasChanged(); // Update the UI
    }
}


<script>
    function triggerClick(element) {
        element.click();
    }
</script>

<style>

    .kyc-upload-main-container {
        width: 95%;
    }

    .kyc-upload-container {
    }

    .kycuploadingblock-uplodcontainer {
        border: 2px solid #D4D9E2;
        background-color: #F5F5F5;
        border-radius: 10px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
    }

    .kycuploadingblock-upload-text {
        color: #9BA2AD;
        font-size: 10px;
    }

    .kycuploadingblock-upload-text-primary {
        color: #9BA2AD;
        font-size: 12px;
        font-weight: bold;
    }
</style>
