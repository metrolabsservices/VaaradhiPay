@page "/kyctest"
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore
@using VaaradhiPay.Components.Pages.TestingByChandu
@using VaaradhiPay.DTOs
@using VaaradhiPay.Data
@using VaaradhiPay.Services
@using VaaradhiPay.Services.Interfaces
@using static VaaradhiPay.Components.Pages.UserView.UserProfilePages.UserProfileBlocks.KycUploadingBlock

@inject ILoggedInUserService LoggedInUserService
@inject ApplicationDbContext DbContext
@inject IUserService userService
@inject UserManager<ApplicationUser> _userManager
@inject ToastService ToastService
@inject IFileStorageService fileStorageService
@inject PreloadService load

<div class="userprofile-kyc-container">
    <h4 class="fw-bold">Upload ID Proof</h4>
    <p class="userprofile-kyc-text mb-4">Please upload the documnet from the list below</p>

    <div class="row justify-content-center mb-4 userprofile-kyc-cards">
        <div class="col-12 col-md-6 col-lg-3 userprofile-kyc-cardblock" @onclick="() => OpenFileUpload(DrivingLicense)">
            <i class="userprofile-kyc-secondary-text-color me-3 bi bi-person-vcard" />
            <p class="p-0 m-0 fw-bold">Driving License</p>
        </div>
        <div class="col-12 col-md-6 col-lg-3 userprofile-kyc-cardblock" @onclick="() => OpenFileUpload(Passport)">
            <i class="userprofile-kyc-secondary-text-color me-3 bi bi-passport" />
            <p class="p-0 m-0 fw-bold">Passport</p>

        </div>
        <div class="col-12 col-md-6 col-lg-3 userprofile-kyc-cardblock" @onclick="() => OpenFileUpload(Aadhaar)">
            <i class="userprofile-kyc-secondary-text-color me-3 bi bi-person-video" />
            <p class="p-0 m-0 fw-bold">Aadhar Card</p>
        </div>
    </div>

    @if (isShowUploadFiles)
    {
        <div>
            <KycUploadingBlock KycType="@nameType" onUploadCheck="UploadedFiles" kYCDetails="kycDetails"/>
        </div>
    }


    <div class="text-end ">
        <button class="userprofile-senddetails-btn bottom-0 end-0" @onclick="SaveFiles"> Send Details</button>
    </div>

</div>


@code {
    private string DrivingLicense = "DRIVING LICENSE";
    private string Passport = "PASSPORT";
    private string Aadhaar = "AADHAR CARD";

    private string nameType;

    private bool isShowUploadFiles = false;

    private Dictionary<string, Dictionary<string, FilePreviewDTO>> filePreviews = new();
    private LoggedInUserDTO userDetails;
    private List<KYCDetails> kycDetails;
    private bool isKYCExist = false;
    private readonly SemaphoreSlim _semaphore = new SemaphoreSlim(1,1);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _semaphore.WaitAsync();
            load.Show();
            userDetails = await LoggedInUserService.GetLoggedInUserAsync();
            if (userDetails != null)
            {
                kycDetails = await DbContext.KYCDetails.Where(e => e.UserId == userDetails.Id).ToListAsync();
                if (kycDetails != null && kycDetails.Any())
                {
                    isKYCExist = true;
                    Console.WriteLine("kyc details loaded");
                }
                await UpdatingKycStatus();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
        finally
        {
            _semaphore.Release();
            StateHasChanged();
            load.Hide();
        }
    }

    public void OpenFileUpload(string documentType)
    {
        if (kycDetails == null || !kycDetails.Any())
        {
            nameType = documentType;
            isShowUploadFiles = true;
        }
        else
        {
            var kyc = kycDetails.Select(e => e.DocumentType).ToList();
            if (kyc.Contains(documentType))
            {
                nameType = documentType;
                isShowUploadFiles = true;
            }
            else
            {
                ToastService.Notify(new ToastMessage { Type = ToastType.Warning, Message = "Details alredy exists" });
            }
        }
    }

    private async Task UploadedFiles(Dictionary<string, Dictionary<string, FilePreviewDTO>> filePreview)
    {
        Console.WriteLine("invoked");
        filePreviews = filePreview;
    }

    //Saving the uploaded files in database and minio
    private async Task SaveFiles()
    {
        string user = userDetails.Email.Split('@')[0];

        if (filePreviews != null && filePreviews.Count > 0)
        {
            foreach (var fileCategory in filePreviews)
            {
                var fileType = fileCategory.Key;
                foreach (var file in fileCategory.Value)
                {
                    try
                    {
                        var kycDetail = kycDetails.Where(e => e.DocumentNumber == file.Key).ToList();
                       
                        var objName = await fileStorageService.UploadingFilesForKYC(file, fileType, kycDetail.Count());

                        var kyc = new KYCDetails()
                            {
                                DocumentType = fileType,
                                DocumentNumber = file.Key,
                                DocumentFilePath = objName,
                                UserId = userDetails.Id
                            };
                        DbContext.KYCDetails.Add(kyc);
                        await DbContext.SaveChangesAsync();
                        await UpdatingKycStatus();
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine(ex.Message);
                    }
                }
            }
        }
    }

    private async Task UpdatingKycStatus()
    {
        try
        {
            if(kycDetails != null)
            {
                var applicationUser = await _userManager.FindByIdAsync(userDetails.Id);

                var kYCDetail = kycDetails.Where(e => !e.IsDeleted).ToList();

                bool hasDocuments = kYCDetail.Any(k => (k.DocumentType == "DRIVING LICENSE" || k.DocumentType == "PASSPORT" || k.DocumentType == "AADHAR CARD"));     // Adjust the condition based on your schema

                if (hasDocuments)
                {
                    if (applicationUser != null && applicationUser.KYCstatus == "Not Started")
                    {
                        applicationUser.KYCstatus = "Progress";
                        await userService.UpdateUserAsync(applicationUser);
                    }
                }
                await DbContext.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex.Message);
        }
    }
}

<style>
    .userprofile-kyc-container {
    }

    .userprofile-kyc-text {
        font-size: 10px;
        color: #9BA2AD;
    }

    .userprofile-kyc-cards {
        gap: 30px;
        --bs-gutter-x: 0;
    }

    .userprofile-kyc-cardblock {
        display: flex;
        justify-content: flex-start;
        padding: 10px 20px;
        border: 1px solid #D4D9E2;
        border-radius: 4px;
        width: 210px;
        cursor: pointer;
    }

    .userprofile-kyc-secondary-text-color {
        color: #9BA2AD;
    }
</style>