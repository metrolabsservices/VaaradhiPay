@using Microsoft.AspNetCore.Identity
@using System.Security.Claims
@using Microsoft.AspNetCore.WebUtilities
@using System.Text
@using System.Text.Encodings.Web
@using VaaradhiPay.Data
@using VaaradhiPay.Services.Interfaces
@inject UserManager<ApplicationUser> _userManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@* @inject IEmailSender<ApplicationUser> EmailSender *@
@inject IEmailSenderService EmailSenders
@inject IEmailSender<ApplicationUser> EmailSender
@inject ToastService ToastService
@inject PreloadService Load
@inject IJSRuntime JS

<Preload LoadingText="..." />
<div class="user-profile-setting-container-1">
    <!-- First Name and Last Name -->
    <div class="user-profile-setting-name-container">
        <div class="user-profile-setting-top-header">
            <p>First Name</p>
            <input type="text" @bind="firstName" />
        </div>
        <div class="user-profile-setting-top-header">
            <p>Last Name</p>
            <input type="text" @bind="lastName" />
        </div>
    </div>

    <!-- Email and Phone Number -->
    <div class="user-profile-setting-name-container">
        <div class="user-profile-setting-top-header">
            <p>Email</p>
            <input type="email" @bind="email" />
        </div>

        <div class="user-profile-setting-phn-container">
            <p>Phone No</p>
            <div class="user-profile-setting-phone-container">
                <div class="user-profile-setting-country-code">
                    <select @bind="selectedCountryCode">
                        @foreach (var country in countryCodes)
                        {
                            <option value="@country.Code">@country.Name (@country.Code)</option>
                        }
                    </select>
                    <i class="bi bi-caret-down-fill"></i>
                </div>
                <input type="tel" class="user-profile-setting-phone-input" @bind="phoneNumber" />
            </div>
        </div>
    </div>

    @* for logout automatically *@
    <form action="Account/Logout" method="post" id="logoutForm">
        @* Anti-forgery token *@
        <AntiforgeryToken />
        <button type="submit" style="border:none;background-color:white;">
            @* ReturnUrl is used to redirect the user after logout *@
            <input type="hidden" name="ReturnUrl" value="@currentUrl" />
        </button>
    </form>

    <!-- Save Button -->
    <div class="user-profile-setting-save-button">
        <button @onclick="SaveUserDetails">Save Details</button>
    </div>
</div>

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />


@code {
    private string firstName;
    private string lastName;
    private string email;
    private string phoneNumber;
    private string selectedCountryCode = "+1";  // Default to USA's country code
    private string errorMessage;
    private string successMessage;
    private string ReturnUrl = "/profile"; // Specify the return URL after confirmation
    private bool islogOut = false;

    private ApplicationUser? applicationUser;  // Declare globally

    private List<Country> countryCodes = new List<Country>
    {
        new Country { Code = "+1", Name = "USA" },
        new Country { Code = "+44", Name = "UK" },
        new Country { Code = "+61", Name = "Australia" },
        new Country { Code = "+91", Name = "India" },
        new Country { Code = "+33", Name = "France" },
        new Country { Code = "+49", Name = "Germany" },
        new Country { Code = "+81", Name = "Japan" },
        // Add more countries as needed
    };

    private ClaimsPrincipal? CurrentUser;
    private string currentUrl = "public";

    protected override async Task OnInitializedAsync()
    {
        var user = await GetAuthenticatedUserAsync();
        if (user != null)
        {
            // Load application user details
            applicationUser = await _userManager.FindByNameAsync(user.Identity.Name);
            if (applicationUser != null)
            {
                firstName = applicationUser.FirstName;
                lastName = applicationUser.LastName;
                email = applicationUser.Email;
                phoneNumber = applicationUser.PhoneNumber;
            }
        }
    }

    // Save user details and send confirmation emails to both emails
    private async Task SaveUserDetails()
    {
        Load.Show();
        var user = await GetAuthenticatedUserAsync();
        if (user == null || applicationUser == null) return;

        var oldEmail = applicationUser.Email;
        if (await IsEmailTakenByAnotherUserAsync(email, applicationUser.Id))
        {
            errorMessage = "This email address is already taken by another user.";
            return;
        }

        // Update user details temporarily (before confirmation)
        UpdateApplicationUser();

        var updateResult = await _userManager.UpdateAsync(applicationUser);
        if (!updateResult.Succeeded)
        {
            errorMessage = string.Join(" ", updateResult.Errors.Select(e => e.Description));
            Load.Hide();
            return;
        }

        if (oldEmail != email)
        {
            // Send both emails (to old email & new email)
            await SendEmailVerification(oldEmail, email);
        }

        ToastService.Notify(new ToastMessage { Type = ToastType.Success, Message = "Details Saved Successfully" });
        Load.Hide();
        if (islogOut)
        {
            await AutoClickButton();
        }
    }

    // Get the currently authenticated user
    private async Task<ClaimsPrincipal?> GetAuthenticatedUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user == null)
        {
            errorMessage = "User not authenticated.";
            return null;
        }
        return user;
    }

    // Check if the email is already taken by another user
    private async Task<bool> IsEmailTakenByAnotherUserAsync(string email, string currentUserId)
    {
        var existingUserWithNewEmail = await _userManager.FindByEmailAsync(email);
        return existingUserWithNewEmail != null && existingUserWithNewEmail.Id != currentUserId;
    }

    // Update the application user object
    private void UpdateApplicationUser()
    {
        applicationUser.FirstName = firstName;
        applicationUser.LastName = lastName;
        applicationUser.Email = email;
        applicationUser.UserName = email;
        applicationUser.EmailConfirmed = false;
        if (!string.IsNullOrEmpty(phoneNumber))
        {
            applicationUser.PhoneNumber = $"{selectedCountryCode} {phoneNumber}";
        }
    }

    // Method to send verification emails to both old and new email addresses
    private async Task SendEmailVerification(string oldEmail, string newEmail)
    {
        if (applicationUser == null) return;

        bool sendEmail = await SendEmailAsync(oldEmail, "Changing Email",
            "We have received a request to change your email address. If this was not you, please contact support immediately. If this was you, please ignore this email.");
        // Send email to old email (informing about email change)
        if (sendEmail)
        {
            sendEmail = false;

            var code = await UserManager.GenerateEmailConfirmationTokenAsync(applicationUser);
            code = WebEncoders.Base64UrlEncode(Encoding.UTF8.GetBytes(code));
            var callbackUrl = $"{NavigationManager.BaseUri}Account/ConfirmEmail?userId={applicationUser.Id}&code={code}";

            // Send confirmation email to new email address
            sendEmail = await SendEmailAsync(newEmail, "Confirm your email address", await EmailSenders.EmailConfirmationLetter(applicationUser, HtmlEncoder.Default.Encode(callbackUrl)));

            if (sendEmail)
            {
                ToastService.Notify(new ToastMessage { Type = ToastType.Success, Message = "New confirmation email has been sent. Please confirm the email to continue." });
                islogOut = true;
            }
        }
    }

    // Helper method to send an email
    private async Task<bool> SendEmailAsync(string emailAddress, string subject, string body)
    {
        try
        {
            await EmailSenders.EmailSendAsync(emailAddress, subject, body);
            return true;
        }
        catch (Exception ex)
        {
            errorMessage = $"Error sending email to {emailAddress}: {ex.Message}";
            return false;
        }
    }

    private async Task AutoClickButton()
    {
        // Use JavaScript to trigger the form submission by invoking submit() on the form element
        await JS.InvokeVoidAsync("eval", "document.getElementById('logoutForm').submit();");
    }

    public class Country
    {
        public string Code { get; set; }
        public string Name { get; set; }
    }
}


