 <Modal @ref="UpiModal" IsScrollable="true"/>
 <Modal @ref="BankModal" IsScrollable="true"/>
 <Modal @ref="CryptoModal" IsScrollable="true"/>




@code {
    private BankAccount SelectedBankAccount { get; set; }

    private UPIAddress SelectedUPI { get; set; }
    private TetherWallet SelectedWallet { get; set; } // Selected wallet for modal
    private List<BankAccount> BankAccountDetails = new();
    private List<TetherWallet> TetherWalletList { get; set; } = new List<TetherWallet>(); // List of wallets
    private List<UPIAddress> UPIAddressList { get; set; } = new List<UPIAddress>(); // List of wallets

    private LoggedInUserDTO userDetails;

    private Modal UpiModal = default!;
    private Modal BankModal = default!;
    private Modal CryptoModal = default!;

    private async Task SetSelectedUPI(UPIAddress upi)
    {
        SelectedUPI = upi;
        await JSRuntime.InvokeVoidAsync("openUPIModal");

    }
    private void SetSelectedBankAccount(BankAccount account)
    {
        SelectedBankAccount = account;
    }
    private async Task SetSelectedWallet(TetherWallet wallet)
    {
        SelectedWallet = wallet;

        // Trigger modal to open programmatically
        await JSRuntime.InvokeVoidAsync("openWalletModal");
    }



    private async Task OpenModal(string modaltype)
    {

        if (modaltype == "UPI")
        {
            var parameters = new Dictionary<string, object>
            {
                { "OnFormSubmit", EventCallback.Factory.Create(this, CloseUPIModal) }
            }; 

            await UpiModal.ShowAsync<ProfileUPIBlock>(title: "Upi Form", parameters: parameters);
        }
        else if (modaltype == "Bank")
        {
            var parameters = new Dictionary<string, object>
            {
                { "OnFormSubmit", EventCallback.Factory.Create(this, CloseBankModal) }
            }; 

            await BankModal.ShowAsync<ProfileBankBlock>(title: "Bank Form", parameters: parameters);

        }
        else if (modaltype == "CryptoWallet")
        {
            var parameters = new Dictionary<string, object>
            {
                { "OnFormSubmit", EventCallback.Factory.Create(this, CloseCryptoModal) }
            }; 

            await CryptoModal.ShowAsync<ProfileCryptoWalletBlock>(title: "CryptoWallet Form", parameters: parameters);

        }

    }

    private async Task CloseUPIModal()
    {
        await UpiModal.HideAsync();
    }
    private async Task CloseBankModal()
    {
        await BankModal.HideAsync();
    }
    private async Task CloseCryptoModal()
    {
        await CryptoModal.HideAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        userDetails = await loggedUser.GetLoggedInUserAsync();

        BankAccountDetails = await bankAccountService.GetBankAccountsByUserIdAsync(userDetails.Id);
        TetherWalletList = await tetherwalletservice.GetActiveTetherWalletsByUserAsync(userDetails.Id);
        UPIAddressList = await UpiAddressService.GetActiveUPIAddressesByUserAsync(userDetails.Id);
    }
}
<script>
    function openModal(accountNumber) {
        var modal = new bootstrap.Modal(document.getElementById('bankAccountModal-' + accountNumber));
        modal.show();
    }

    function openUPIModal() {
        // Trigger the modal open action
        var modal = new bootstrap.Modal(document.getElementById('upiModal'));
        modal.show();
    }

    window.openWalletModal = function () {
        var modal = new bootstrap.Modal(document.getElementById('cryptoWalletModal'));
        modal.show();
    };

</script>

