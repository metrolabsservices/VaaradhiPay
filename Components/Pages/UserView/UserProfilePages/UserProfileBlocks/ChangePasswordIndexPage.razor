@using System.Security.Claims
@using Microsoft.AspNetCore.Identity
@using VaaradhiPay.Data
@inject UserManager<ApplicationUser> _userManager;
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ToastService ToastService
@inject PreloadService Load

<style>
    .bottom-container {
        display: flex;
        flex-direction: column;
        padding: 10px 0 0 0;
    }

    .old-password {
        display: grid;
        justify-content: center;
    }

        .old-password input {
            width: 275px;
            height: 50px;
            border: solid;
            border-width: 1px;
            border-color: #D4D9E2;
            border-radius: 4px;
        }

        .old-password p {
            font-size: 11px;
            font-weight: 400;
            font-family: "Poppins";
            color: #67757C;
        }

    .save-button button {
        width: 180px;
        height: 41px;
        font-size: 14px;
        font-weight: 600;
        background-color: #DF0A0A;
        border: none;
        border-radius: 24px;
        color: #ffffff;
        letter-spacing: 1px;
        padding: 10px;
        text-transform: uppercase;
    }

    .save-button {
        display: flex;
        justify-content: center;
        margin: 30px 0 0 0;
    }

    .error-message {
        color: red;
        font-size: 12px;
        text-align: center;
    }

    .success-message {
        color: green;
        font-size: 12px;
        text-align: center;
    }
</style>

<Preload LoadingText="..." />

<div class="bottom-container">
    <div class="old-password">
        <p>Old Password</p>
        <input type="password" @bind-value="oldPassword">
    </div>
    <div class="old-password">
        <p>New Password</p>
        <input type="password" @bind-value="newPassword">
    </div>
    <div class="old-password">
        <p>Confirm Password</p>
        <input type="password" @bind-value="confirmPassword">
    </div>


    <div class="save-button">
        <button type="button" @onclick="OnChangePassword">Save Details</button>
    </div>
</div>

<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.TopRight" />


@code {
    private string oldPassword;
    private string newPassword;
    private string confirmPassword;
    private string errorMessage;
    private string successMessage;
    
    private ClaimsPrincipal? CurrentUser;
    private ApplicationUser? applicationUser;  // Declare globally

    protected override async Task OnInitializedAsync()
    {
        CurrentUser = await GetAuthenticatedUserAsync();
    }

    // Get the currently authenticated user
    private async Task<ClaimsPrincipal?> GetAuthenticatedUserAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        if (user == null)
        {
            errorMessage = "User not authenticated.";
            return null;
        }
        return user;
    }


    private async Task OnChangePassword()
    {
        Load.Show();
        errorMessage = string.Empty; // Reset error message
        successMessage = string.Empty; // Reset success message

        if (string.IsNullOrEmpty(oldPassword) || string.IsNullOrEmpty(newPassword) || string.IsNullOrEmpty(confirmPassword))
        {
            ToastService.Notify(new ToastMessage { Type = ToastType.Warning, Message = "Please fill the fields" });
            Load.Hide();
            return;
        }

        if (newPassword != confirmPassword)
        {
            ToastService.Notify(new ToastMessage { Type = ToastType.Success, Message = "Password do not match" });
            Load.Hide();
            return;
        }

        var applicationUser = await _userManager.FindByNameAsync(CurrentUser.Identity.Name);
        if (CurrentUser == null)
        {
            ToastService.Notify(new ToastMessage { Type = ToastType.Danger, Message = "User not authenticated" });
            Load.Hide();
            return;
        }

        var changePasswordResult = await _userManager.ChangePasswordAsync(applicationUser, oldPassword, newPassword);

        if (changePasswordResult.Succeeded)
        {
            ToastService.Notify(new ToastMessage { Type = ToastType.Success, Message = "Password Changed Successfully" });
        }
        else
        {
            ToastService.Notify(new ToastMessage { Type = ToastType.Danger, Message = "Incorrect password" });
        }
        Load.Hide();
    }
}
