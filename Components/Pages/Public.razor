@page "/public"

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.WebUtilities
@using VaaradhiPay.Components.Layout
@using VaaradhiPay.Components.Pages.SignInSignUpFlow
@using VaaradhiPay.Components.Pages.L2
@using VaaradhiPay.Components.Pages.TestingBlocks

@rendermode InteractiveServer

@attribute [AllowAnonymous]

@layout EmptyLayout

@inject NavigationManager Nav

<Modal @ref="signin_signup_modal" IsScrollable="true" />
<Modal @ref="signin_signup_modal1" IsScrollable="true" />

<header class="public-layout-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container-fluid">
            <a class="navbar-brand" href="/home">
                <img class="public-layout-logo" alt="Vaaradhi pay img" src="MediaFiles/Logos/VaaradhiPay_Logo.png" />
            </a>
            <div class="d-flex">
                <Button Size="ButtonSize.Small" Class="public-layout-buttons public-layout-button-odd"
                    @onclick="@(() => NavigateToPage("login"))"> Login </Button>
                <Button Size="ButtonSize.Small" Class="public-layout-buttons"
                    @onclick="@(() => NavigateToPage("register"))"> SIGN UP </Button>
            </div>
        </div>
    </nav>
</header>

<main class="public-layout-content">
    <div class="public-top-content">
        <div class="public-exchange-card">
            <ExchangeCard />
        </div>
        <div class="public-text-content">
            <PublicTextContent />
        </div>
    </div>
    <div class="public-middle-content">
        <div class="public-lasthour-exchanges">
            <LastHourExchanges />
        </div>
        <div class="public-new-updates">
            <NewUpdates />
        </div>
    </div>
    <div>
        <div>
            <ProfileAvatarGroup />
        </div>
        <div>
            <ReviewSwapContent />
        </div>
    </div>
</main>
<footer class="layout-footer">
    <Footer />
</footer>

@code {
    private Modal signin_signup_modal = default!;
    private Modal signin_signup_modal1 = default!;
    private bool isModalProcessing = false;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (QueryHelpers.ParseQuery(uri.Query).TryGetValue("modal", out var modalType))
        {
            Console.WriteLine(modalType.ToString());
            await NavigateToPage(modalType.ToString());

        }
    }


    public async Task NavigateToPage(string message)
    {
        if (message == "login")
        {
            var parameters = new Dictionary<string, object>();
            await signin_signup_modal1.ShowAsync<VaaradhiPayLoginPage>(
            title: "Login",
            parameters: parameters
            );
        }
        else if (message == "register")
        {
            var parameters = new Dictionary<string, object>
{
{ "OnRegistrationSuccess", EventCallback.Factory.Create(this, CloseRegisterModal) }
};
            await signin_signup_modal.ShowAsync<VaaradhiPayRegisterPage>(
            title: "Sign Up",
            parameters: parameters
            );
        }

        Console.WriteLine($"Navigated to: {message}");
    }

    private async Task CloseRegisterModal()
    {
        await signin_signup_modal.HideAsync();

        await Task.Delay(100);

        await NavigateToPage("login");
    }


}


<style>
    .public-layout-buttons {
        background-color: #DF0A0A;
        color: white;
        font-size: 10px;
        font-weight: 600;
        padding: 5px 20px;
        border-radius: 15px;
    }

    .public-layout-button-odd {
        background-color: transparent !important;
        color: black;
        font-size: 12px;
    }

    /* Public Layout Header */
    .public-layout-header {
        position: sticky;
        z-index: 1;
        top: 0;
        border-bottom: 1px solid white;
        background-color: #FCE2E0;
    }

    /* Public Layout Logo */
    .public-layout-logo {
        height: 2.8rem;
        width: 6rem; 
    }

    /* Public Layout Content */
    .public-layout-content {
        /* min-height: 80vh; */
        padding: 2rem;
        background-color: #FFF5F4;
        /* overflow: auto; */
    }

    /* Public Layout Footer */
    .public-layout-footer {
        position: sticky;
        bottom: 0;
        border-top: 1px solid white;
        font-size: 0.9rem;
    }


    /* Public page component css */

    .public-middle-content {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 20px;
        margin-bottom: 100px;
    }

    .public-top-content {
        display: flex;
        flex-direction: row;
        justify-content: center;
        gap: 100px;
        margin-bottom: 100px;
    }

    @@media (max-width: 1080px) {
        .public-top-content {
            gap: 20px;
        }

        .public-middle-content {
            flex-direction: column;
            align-items: center;
            gap: 60px;
        }
    }

    @@media (max-width: 1000px) {
        .public-top-content {
            flex-direction: column-reverse;
            align-items: center;
            gap: 40px;
        }
    }
</style>