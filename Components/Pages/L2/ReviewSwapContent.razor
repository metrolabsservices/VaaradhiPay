@page "/customerreviews"

@rendermode InteractiveServer

<div class="review-container">
    <div class="review-container-content">
        @foreach (var review in reviews.Select((r, i) => new { Review = r, Index = i }))
        {
            <div class="review-content @(review.Index == currentIndex ? "visible" : "hidden")">
                <div class="review-content-img">
                    <img src="@review.Review.ImageUrl" alt="image">
                </div>
                <div class="review-content-text">
                    <h3>@review.Review.Name</h3>
                    <p>@review.Review.Comment</p>
                    <h6>@review.Review.Title</h6>
                </div>
            </div>
        }
        <div class="left-arrow-div" @onclick="PrevSlide">
            <span class="left-arrow"><i class="bi bi-chevron-left"></i></span>
        </div>
        <div class="right-arrow-div" @onclick="NextSlide">
            <span class="right-arrow"><i class="bi bi-chevron-right"></i></span>
        </div>
    </div>
</div>

<style>
    .review-container {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .review-content {
        display: none;
        flex-direction: row;
        align-items: center;
        gap: 50px;
        justify-content: center;
        @* text-align: center; *@
    }

    .review-content.visible {
        display: flex; /* Only the active review is displayed */
    }

    .review-content-img img {
        width: 250px;
        height: 250px;
        border-radius: 50%;
    }

    .review-content-text {
        width: 380px;
    }

    .review-content-text h3 {
        margin-bottom: 20px;
    }

    .review-content-text h3,
    .review-content-text h6 {
        font-size: 20px;
        font-weight: 600;
    }

    .review-content-text p {
        font-size: 18px;
        font-weight: normal;
        line-height: 33px;
        margin-bottom: 10px;
    }

    .bi-chevron-left,
    .bi-chevron-right {
        font-size: 100px;
        color: grey;
    }

    .bi-chevron-right {
        position: absolute;
        top: 40px;
        right: 150px;
        cursor: pointer;
    }

    .bi-chevron-left {
        position: absolute;
        top: 40px;
        left: 150px;
        cursor: pointer;
    }
    .review-container-content {
        position: relative;
        width: 100%;
    }
    @@media (max-width: 1200px) {
        .bi-chevron-left {
            left: 10px;
        }
        .bi-chevron-right {
            right: 10px;
        }
    }
    @@media (max-width: 920px) {
        .bi-chevron-left {
            left: 50px;
            font-size: 60px;
            top: 80px;
        }
        .bi-chevron-right {
            right: 50px;
            font-size: 60px;
            top: 80px;
        }
        .review-content{
            flex-direction: column;
        }
        .review-content {
            text-align: center;
        }
    }
    @@media (max-width: 540px) {
        .bi-chevron-left {
            left: -20px;
            font-size: 60px;
            top: 80px;
        }
        .bi-chevron-right {
            right: -20px;
            font-size: 60px;
            top: 80px;
        }
    }
    @@media (max-width: 376px) {
        .bi-chevron-left {
            left: -40px;
            font-size: 50px;
            top: 80px;
        }
        .bi-chevron-right {
            right: -40px;
            font-size: 50px;
            top: 80px;
        }
        .review-content-text {
            width: auto;
        }
    }

</style>

