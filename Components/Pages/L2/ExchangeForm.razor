@page "/excform"

@using Microsoft.EntityFrameworkCore
@using VaaradhiPay.Components.Pages.L1
@using VaaradhiPay.Components.Pages.L1.ErrorTemplates
@using VaaradhiPay.DTOs
@using VaaradhiPay.Data
@using VaaradhiPay.Services.Interfaces
@using VaaradhiPay.Utilities

@inject ILoggedInUserService LoggedInUserService
@inject ICoinTypeService CoinTypeService
@inject ToastService Toast
@inject PreloadService Load
@inject ApplicationDbContext DbContext

@inherits ComponentBase

<div class="exchangeform-container">
    <div class="input-container">
        <div class="input-wrapper">
            <p class="input-label-text">You Pay</p>
            <input class="main-input-field" type="number" @bind="youPayValue" @bind:event="oninput" @onkeyup="CalculateReceivedValue" />
        </div>
        <div class="input-dropdown">
            <select class="form-select form-select-sm" @bind="selectedCurrencyPay" @bind:event="oninput" @onchange="CalculateReceivedValue">
                @foreach (var coin in ExchangeSet1)
                {
                    <option value="@coin.Key">@coin.Value</option>
                }
            </select>

        </div>
    </div>

    <div class="input-container">
        <div class="input-wrapper">
            <p class="input-label-text">You will receive Roughly</p>
            <input class="main-input-field" type="number" @bind="youReceiveValue" @bind:event="oninput" @onkeyup="CalculateReceivedValue2" />
            @* <input class="main-input-field" type="number" value="@youReceiveValue" readonly /> *@
            @* <p class="main-input-field m-0 p-0">@youReceiveValue.ToString("F2")</p> *@
            @* <p class="main-input-field m-0 p-0">@((Math.Floor(youReceiveValue * 1000) / 1000).ToString("F3"))</p> *@

        </div>
        <div class="input-dropdown">
            <select class="form-select form-select-sm" @bind="selectedCurrencyReceive" @bind:event="oninput" @onchange="CalculateReceivedValue">
                @foreach (var coin in ExchangeSet2)
                {
                    <option value="@coin.Key">@coin.Value</option>
                }
            </select>

        </div>
    </div>

    <button class="exchange-btn" @onclick="HandleSubmit">EXCHANGE</button>
</div>

<Modal @ref="UserLogRequired" UseStaticBackdrop="true" CloseOnEscape="false" />


@code {
    [Parameter] public EventCallback<ExchangeTransactionDTO> OnTransactionCompleted { get; set; }
    [Parameter] public bool IsBuyTab { get; set; }

    private Modal UserLogRequired = default!;
    private List<CoinType> AvailableCoins = new();
    private string selectedCurrencyPay = "INR";
    private string selectedCurrencyReceive = "USDT";
    private decimal youPayValue = 0;
    private decimal youReceiveValue = 0;
    private ErrorHandleDTO errorDetails = new();

    private Dictionary<string, string> ExchangeSet1 = CurrencySets.DigitalCurrencySet;
    private Dictionary<string, string> ExchangeSet2 = CurrencySets.PaperCurrencySet;

    private decimal LiveINR;
    private decimal LiveAED;
    private decimal LiveUSD = 1;
    private ExchangeRateHistory exchangeRateHistory;

    protected override Task OnParametersSetAsync()
    {
        Console.WriteLine($"IsBuyTab: {IsBuyTab}"); // Log the current tab status to the console
        if (IsBuyTab)
        {
            ExchangeSet1 = CurrencySets.PaperCurrencySet;
            ExchangeSet2 = CurrencySets.DigitalCurrencySet;
        }
        else if (!IsBuyTab)
        {
            ExchangeSet2 = CurrencySets.PaperCurrencySet;
            ExchangeSet1 = CurrencySets.DigitalCurrencySet;
        }
        else
        {
            Console.WriteLine("Unable to load Options");
        }
        youPayValue = 0;
        youReceiveValue = 0;
        return Task.CompletedTask;
    }

    protected override async Task OnInitializedAsync()
    {
        Load.Show(); // Display loading spinner
        try
        {
            AvailableCoins = await CoinTypeService.GetActiveCoinsAsync();
            LiveINR = await DbContext.Currencies.Where(e => e.ISOCode == "INR").Select(e => e.Rate).FirstOrDefaultAsync();
            LiveAED = await DbContext.Currencies.Where(e => e.ISOCode == "AED").Select(e => e.Rate).FirstOrDefaultAsync();
            exchangeRateHistory = await DbContext.ExchangeRateHistories.OrderByDescending(e => e.CreatedDate).FirstOrDefaultAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Toast.Notify(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Message = "Unable to load data. Please try again later."
                });
            errorDetails = new ErrorHandleDTO
                {
                    IsError = true,
                    Message = "Unable to load data. Please try again later.",
                    TechnicalMessage = ex.Message
                };
        }
        finally
        {
            Load.Hide(); // Hide loading spinner
        }
    }

    private async Task CalculateReceivedValue()
    {
        Console.WriteLine($"{selectedCurrencyPay} , {selectedCurrencyReceive}");
        Load.Show(); // Display loading spinner

        try
        {
            decimal USDT = 1;
            decimal NAFA = 1;
            if (IsBuyTab)
            {
                if (selectedCurrencyReceive == "USDT")
                {
                    decimal inr = exchangeRateHistory.BuyRateUsdt;
                    if (selectedCurrencyPay == "INR")
                    {
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountUsdt / 100));
                        youReceiveValue = (decimal)((payAmount * USDT) / inr);
                    }

                    if (selectedCurrencyPay == "USD")
                    {
                        decimal usd = (inr * LiveUSD) / LiveINR;
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountUsdt / 100));
                        youReceiveValue = (decimal)((payAmount * USDT) / usd);
                    }

                    if (selectedCurrencyPay == "AED")
                    {
                        decimal aed = (inr * LiveAED) / LiveINR;
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountUsdt / 100));
                        youReceiveValue = (decimal)((payAmount * USDT) / aed);
                    }
                }
                else if (selectedCurrencyReceive == "NAFA")
                {
                    decimal inr = exchangeRateHistory.BuyRateNafa;
                    if (selectedCurrencyPay == "INR")
                    {
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountNafa / 100));
                        youReceiveValue = (decimal)((payAmount * NAFA) / inr);
                    }

                    if (selectedCurrencyPay == "USD")
                    {
                        decimal usd = (inr * LiveUSD) / LiveINR;
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountNafa / 100));
                        youReceiveValue = (decimal)((payAmount * NAFA) / usd);
                    }

                    if (selectedCurrencyPay == "AED")
                    {
                        decimal aed = (inr * LiveAED) / LiveINR;
                        var payAmount = youPayValue - (youPayValue * (exchangeRateHistory.TaxAmountNafa / 100));
                        youReceiveValue = (decimal)((payAmount * NAFA) / aed);
                    }
                }
            }
            else
            {
                if (selectedCurrencyReceive == "USDT")
                {
                    decimal inr = exchangeRateHistory.SellRateUsdt;
                    if (selectedCurrencyPay == "INR")
                    {
                        var receiveAmount = (youPayValue * inr) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountUsdt / 100)));
                    }

                    if (selectedCurrencyPay == "USD")
                    {
                        decimal usd = (inr * LiveUSD) / LiveINR;
                        var receiveAmount = (youPayValue * usd) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountUsdt / 100)));
                    }

                    if (selectedCurrencyPay == "AED")
                    {
                        decimal aed = (inr * LiveAED) / LiveINR;
                        var receiveAmount = (youPayValue * aed) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountUsdt / 100)));
                    }
                }
                else if (selectedCurrencyReceive == "NAFA")
                {
                    decimal inr = exchangeRateHistory.SellRateNafa;
                    if (selectedCurrencyPay == "INR")
                    {
                        var receiveAmount = (youPayValue * inr) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountNafa / 100)));
                    }

                    if (selectedCurrencyPay == "USD")
                    {
                        decimal usd = (inr * LiveUSD) / LiveINR;
                        var receiveAmount = (youPayValue * usd) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountNafa / 100)));
                    }

                    if (selectedCurrencyPay == "AED")
                    {
                        decimal aed = (inr * LiveAED) / LiveINR;
                        var receiveAmount = (youPayValue * aed) / USDT;
                        youReceiveValue = (decimal)(receiveAmount - (receiveAmount * (exchangeRateHistory.TaxAmountNafa / 100)));
                    }
                }
            }

            // Error Free
            errorDetails = new ErrorHandleDTO { IsError = false };
        }
        catch (Exception ex)
        {
            Console.WriteLine(ex);
            Toast.Notify(new ToastMessage
                {
                    Type = ToastType.Danger,
                    Message = "An error occurred while calculating the exchange value. Please try again."
                });
            errorDetails = new ErrorHandleDTO
                {
                    IsError = true,
                    Message = "An error occurred while calculating the exchange value. Please try again.",
                    TechnicalMessage = ex.Message
                };

        }
        finally
        {
            Load.Hide(); // Hide loading spinner
        }
    }

