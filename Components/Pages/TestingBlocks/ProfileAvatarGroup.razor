@page "/avatartest"

@using VaaradhiPay.Components.Pages.L1
@using VaaradhiPay.DTOs
@using VaaradhiPay.Components.Layout

@rendermode InteractiveServer

@layout EmptyLayout

@inherits ComponentBase

<div class="profile-avatar-header">
    <h1>Our Customer Love What we do</h1>
    <p>Transform your Ideas into Reality with Vaaradhi</p>
</div>
<div class="comments-avatar-group mt-5">
    @for (int i = 0; i < 5; i++)

    {
        <AvatarGroup AvatarImage="@ProfileList[i].ProfilePicturePath" AvatarName="@ProfileList[i].Name" />
    }
</div>
<div class="profile-avatar-text">
    <p>30+ Customer Reviews</p>
</div>

