@using VaaradhiPay.Components.Layout

@inject NavigationManager Nav
@layout EmptyLayout

<div class="container-fluid confirmmail-main-container d-flex justify-content-center align-items-center">
    <div class="confirmmail-container bg-white p-4 mb-3 text-center">
        <img class="confirmmail-icon-prop mb-4" src="MediaFiles/Icons/Email_Icon.png" alt="Emial Icon" />
        <h3 class="fw-bold mb-4">Confirmation Email</h3>
        <p class="mb-4">Thank You for Confirming</p>
        <p class="mb-4">You have Registered Successfully. Click below to Log into your Account.</p>
        <a href="/public" class="btn btn-link"  @onclick="NavigateToLogin" >LOGIN</a>
   </div>
</div>
<Footer />

@code {
    private void NavigateToLogin()
    {
        Nav.NavigateTo("/public?modal=login");
    }
}

<style>
    .confirmmail-icon-prop{
        width: 100px;
        height: 100px;
    }
    .confirmmail-main-container{
        width: 100%;
        height: 90%;
        background-image: url("MediaFiles/Images/vaaradhipay-bg1.png");
        background-size: cover;
        background-repeat: no-repeat;
    }
    .confirmmail-container{
        align-content: center;
        min-width: auto;
        min-height: auto;
        border-radius: 15px;
        box-shadow: 0px 0px 30px rgba(0, 0, 0, 0.15);
    }
</style>


