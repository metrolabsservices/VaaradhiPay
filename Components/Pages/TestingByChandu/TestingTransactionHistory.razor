@page "/TH"
@using VaaradhiPay.Components.Pages.L2
@using VaaradhiPay.DTOs

@rendermode InteractiveServer

<div class="transaction-history">
    <h3 style="color:white;">TestingTransactionHistory</h3>

    <div class="col-8 col-md-8 userprofile-tab-container" style="overflow:auto;scrollbar-width:none;">
        <TabSwitcherKeyContentBlock Tabs="UserProfileTab" activeTab="1" />
    </div>
</div>


@code {
    private List<TabItemDTO> UserProfileTab = new List<TabItemDTO> {
    new TabItemDTO
        {
            TabId = 1,
            Name = "ALL",
            Content =@<TestingALL />
        },
    new TabItemDTO
        {
            TabId = 2,
            Name = "BUY",
            Content = @<p>BUY</p>
        },
    new TabItemDTO
        {
            TabId = 3,
            Name = "SELL",
            Content = @<p>SELL</p>
        }
    };
}


<style>
    .transaction-history{
        display:flex;
        flex-direction:column;
        justify-content:center;
        align-items:center;
    }
    .userprofile-tab-container {
        width: 80%;
        height: 412px;
        background-color: white;
        border-radius: 15px;
        box-shadow: 0px 0px 20px 0px rgba(0, 0, 0, 0.25);
    }

    @@media (max-width: 768px) {
        .userprofile-tab-container {
            width: 100%;
            /* Forces full width for smaller screens */
            margin-top: 10px;
            /* Add some spacing between blocks */
        }
    }

    .userprofile-senddetails-btn {
        background-color: #DF0A0A;
        color: white;
        border-radius: 24px;
        border: none;
        padding: 8px 15px;
        font-size: 15px;
        font-weight: bold;
    }
</style>