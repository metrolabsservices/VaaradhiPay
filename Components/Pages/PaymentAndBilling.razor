@page "/bill"

@rendermode InteractiveServer

@using VaaradhiPay.Components.Pages.L1
@using VaaradhiPay.Components.Pages.L1.PaymentAndBillingPages
@using VaaradhiPay.DTOs
@using VaaradhiPay.Services.Implementations

@inject ExchangeTransactionService ExchangeTransactionService
@inject PreloadService Load
@inject ToastService Toast
@inject NavigationManager navigationManager

@inject ExchangeTransactionService ExchangeTransactionService

<h3 class="text-center text-white mb-4">Payment & Bill</h3>

<Preload LoadingText="..Loading" />
<Toasts class="p-3" AutoHide="true" Delay="4000" Placement="ToastsPlacement.MiddleRight" />



<div class="d-flex justify-content-center w-100">
    <div class="rounded-3 w-75 bg-white p-5">
        <VaaradhiPay.Components.Pages.TestingByChandu.PaymentButtons T="CustomButtonModel" ButtonItems="PaymentMethods" OnButtonSelected="HandleButtonClick" />
        <StepperTransaction CurrentStep="currentStep" />
        <div class="d-flex justify-content-center align-items-center my-3">
            @if (currentStep == 1)
            {
                <PaymentVerification selectedPayment="@selectedPayment" TransactionData="ExchangeTransactionService.CurrentTransaction" OnValidationStateChanged="HandleValidationStateChanged" />
            }
            else if (currentStep == 2)
            {
                <PaymentPage selectedPayment="@selectedPayment" OnValidationStateChanged="HandleValidationStateChanged" OnFinal="FinalSucessPage" />
            }
            else if (currentStep == 3)
            {
                <PaymentSuccessPage />
            }
            else
            {

            }
        </div>

        <div class="w-100 d-flex justify-content-between">

            @if (!IsPreviousDisabled)
            {
                <button class="btn btn-sm btn-danger"
                        @onclick="HandlePreBtn">
                    Previous
                </button>
            }
            else
            {
                <span></span>
            }

            @if (!IsNextDisabled)
            {
                <button class="btn btn-sm btn-danger"
                        @onclick="HandleNexBtn" disabled="@(displayButton == "Continue" && !IsUploaded)">
                    @displayButton
                </button>
            }
            else
            {
                <span></span>
            }

        </div>
    </div>
</div>

@code {
    private int currentStep = 1;
    private bool canProceed = true; // Tracks if the user can proceed
    private bool IsPreviousDisabled => currentStep == 1 || currentStep == 3; // Dynamically determine if "Previous" is disabled
    private bool IsNextDisabled => currentStep == 3;     // Dynamically determine if "Next" is disabled
    private string selectedPayment = "Bank Transfer";
    private string displayButton = "Next";
    private bool IsUploaded = false;
    private void HandlePreBtn()
    {
        if (currentStep > 1)
        {
            currentStep--;
            ButtonVisibilityCheck();
            StateHasChanged();
        }
    }

    private void HandleNexBtn()
    {
        if (currentStep == 1 && ExchangeTransactionService.SelectedBank == null)
        {
            Toast.Notify(new ToastMessage { Type = ToastType.Danger, Message = $"Please select a bank account to proceed." });
            return;
        }
        if (!canProceed)
        {
            Toast.Notify(new ToastMessage { Type = ToastType.Danger, Message = $"Please resolve the issues on this step before proceeding." });

            return;
        }
        if (currentStep < 3)
        {
            currentStep++;
            ButtonVisibilityCheck();
            StateHasChanged();
        }
    }

    private void HandleValidationStateChanged(bool isValid)
    {
        canProceed = isValid;
        if (!canProceed)
        {
            Toast.Notify(new ToastMessage { Type = ToastType.Danger, Message = $"Validation failed. Please check the current step and resolve the issues." });
        }
    }

    private void FinalSucessPage(bool IsUploaded)
    {
        canProceed = IsUploaded;
        if (!canProceed)
        {
            Toast.Notify(new ToastMessage { Type = ToastType.Danger, Message = $"Upload Failed. Please Try again later" });
        }
        this.IsUploaded = IsUploaded;
        HandleNexBtn();
    }

    private void HandleButtonClick(CustomButtonModel button)
    {
        foreach (var p in PaymentMethods)
        {
            if (p.IsButtonActive == true)
            {
                p.IsButtonActive = false;
            }
        }
        button.IsButtonActive = true;
        selectedPayment = button.DisplayText;
        currentStep = 1;
    }

    private void ButtonVisibilityCheck()
    {
        if (currentStep == 1)
        {
            displayButton = "Next";
            foreach (var p in PaymentMethods)
            {
                if (p.IsVisible == false)
                {
                    p.IsVisible = true;
                }
            }
            ExchangeTransactionService.SelectedBank = null;
        }
        if (currentStep == 2)
        {
            displayButton = "Continue";
            foreach (var p in PaymentMethods)
            {
                if (p.IsVisible == true && p.DisplayText != selectedPayment)
                {
                    p.IsVisible = false;
                }
            }
        }
    }

    public List<CustomButtonModel> PaymentMethods = new List<CustomButtonModel>
      {
          new CustomButtonModel
          {
              DisplayText = "Bank Transfer",
              NavigationLink = "bank-transfer-link",
              Icon = "bank-icon-class",
              IsButtonDisabled = false,
              IsButtonActive = true,
              IsVisible = true
          },
          new CustomButtonModel
          {
              DisplayText = "UPI",
              NavigationLink = "upi-transfer-link",
              Icon = "upi-icon-class",
              IsButtonDisabled = false,
              IsButtonActive = false,
              IsVisible = true
          },
          new CustomButtonModel
          {
              DisplayText = "Binance Pay",
              NavigationLink = "binance-pay-link",
              Icon = "binance-icon-class",
              IsButtonDisabled = true,
              IsButtonActive = false,
              IsVisible = true
          },
          new CustomButtonModel
          {
              DisplayText = "Wazirx",
              NavigationLink = "wazirx-link",
              Icon = "wazirx-icon-class",
              IsButtonDisabled = true,
              IsButtonActive = false,
              IsVisible = true
          }
      };

}


