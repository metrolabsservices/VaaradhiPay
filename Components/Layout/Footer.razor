@page "/footer"
@inherits ComponentBase


<!-- Footer Component Definition -->
<footer class="footer">
    <div class="footer-left">
        <p>© 2024 Vaaradhi Pay, All Rights Reserved</p>
    </div>
    <div class="footer-right">
        <p><a href="#">Terms of Use</a> | <a href="#">Privacy Policy</a></p>
    </div>
</footer>

<style>
    /* Footer styles */
    .footer {
        width: 100%;
        height: 55px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 0 100px;
        background-color: #000;
        color: white;
    }

    /* Left section */
    .footer-left p {
        font-family: Poppins, sans-serif;
        font-size: 14px;
        font-weight: 400;
        line-height: 21px;
        text-align: left;
        text-underline-position: from-font;
        text-decoration-skip-ink: none;
        margin: 0;
        width: auto;
        height: 21px;
    }

    /* Right section */
    .footer-right p {
        font-family: Poppins, sans-serif;
        font-size: 14px;
        font-weight: 400;
        line-height: 21px;
        text-align: right;
        text-underline-position: from-font;
        text-decoration-skip-ink: none;
        margin: 0;
        width: auto;
        height: 21px;
    }

    /* Link styles for Terms of Use and Privacy Policy */
    .footer-right a {
        text-decoration: none;
        color: inherit;
    }

        .footer-right a:hover {
            text-decoration: underline;
        }

    /* mobile responsive  */
    @@media (max-width: 767px) {
        .footer {
            height: 42px;
            display: flex;
            flex-direction: column;
            padding: 0 50px;
        }

        .footer-left p,
        .footer-right p {
            font-size: 11px !important;
        }
    }
</style>