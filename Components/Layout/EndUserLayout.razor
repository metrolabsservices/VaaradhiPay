@page "/enduser"
@using VaaradhiPay.DTOs
@using VaaradhiPay.Services.Implementations
@using VaaradhiPay.Services.Interfaces

@inherits LayoutComponentBase

@layout EmptyLayout
@inject ILoggedInUserService loggedUser
@inject ExchangeTransactionService LocalStorage


<div class="layout-container">
    <!-- Header -->
    <header class="layout-header sticky-top">
        <NavBarTop UserRole="@userrole" />
    </header>

    <!-- Main Body -->
    <main class="layout-body">
        @Body
    </main>

    <!-- Footer -->
    <footer class="layout-footer">
        <Footer />
    </footer>
</div>



@code {
    private LoggedInUserDTO userDetail;

    public string userrole = "User";

    protected override async Task OnInitializedAsync()
    {
        userDetail = await loggedUser.GetLoggedInUserAsync();
        if (userDetail != null)
        {
            LocalStorage.LoggedInInfo = userDetail;
        }


        var userDetails = await loggedUser.GetLoggedInUserDetailsAsync();

        if (!string.IsNullOrEmpty(userDetails.Error))
        {
            Console.WriteLine($"Error: {userDetails.Error}");
        }

        Console.WriteLine($"User ID: {userDetails.UserId}");
        Console.WriteLine($"User Name: {userDetails.UserName}");
        Console.WriteLine($"Roles: {userDetails.Role}");
        userrole = userDetails.Role;
    }
}

<style>
    .layout-container {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
    }

    .layout-header {
        z-index: 1000;
    }

    .layout-body {
        flex-grow: 1;
        padding: 1rem;
        background-image: url("MediaFiles/Images/vaaradhipay-bg1.png");
        background-size: cover;
        background-repeat: no-repeat;
        overflow-y: auto;
        -ms-overflow-style: none;
        scrollbar-width: none;
    }

        .layout-body::-webkit-scrollbar {
        display: none;
    }
    .layout-footer {
     
    }
</style>